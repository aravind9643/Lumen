# Copy to `.env` and fill in. Every value is optional — with none set, the site
# runs fully functional and makes zero third-party requests.

# Canonical origin, used for og:url, canonical links, and sitemap.xml.
# IMPORTANT: set this before a production build. The fallback is a placeholder
# domain, and shipping canonical tags pointing at it is worse than omitting them.
VITE_SITE_URL=https://your-domain.com

# Social preview image, relative to the site root (e.g. /og.png in public/).
# Leave empty and no og:image is emitted — the Twitter card then degrades to a
# plain summary rather than rendering an empty large-image card.
VITE_OG_IMAGE=

# Google Analytics 4 measurement ID. Leave empty to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=

# Google AdSense. The client ID alone is not enough — each placement needs its
# own slot ID from the AdSense dashboard, or that unit stays hidden.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_IN_ARTICLE=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_FOOTER=
