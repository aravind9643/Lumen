# Style is convention-only in this repo (no Prettier). This keeps editors
# from silently disagreeing about the basics.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Trailing spaces are meaningful in Markdown line breaks.
trim_trailing_whitespace = false
